---
/**
 * Layout — shared <head>, fonts, theme color, lucide runtime.
 * Used by index.astro and the registry pages. Starlight docs render their
 * own HTML so they don't go through this layout.
 */
import "../styles/global.css"
import Nav from "../components/Nav.astro"
import Footer from "../components/Footer.astro"

interface Props {
  title: string
  description?: string
  ogTitle?: string
  ogDescription?: string
  ogImage?: string
}

const {
  title,
  description = "Declarative control for your Elgato Stream Deck. Linux, macOS, Windows.",
  ogTitle = "SirenoDECK",
  ogDescription = "Buttons belong in your dotfiles.",
  ogImage,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="theme-color" content="#0a0a0f" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      document.documentElement.classList.add("js")
      try {
        const savedTheme = localStorage.getItem("color-scheme")
        document.documentElement.dataset.theme =
          savedTheme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")
        if (savedTheme) document.documentElement.style.colorScheme = savedTheme
        document.querySelector('meta[name="theme-color"]')?.setAttribute(
          "content",
          document.documentElement.dataset.theme === "dark" ? "#0a0a0f" : "#f3fcf4",
        )
      } catch {}
    </script>
    <!-- Lucide icon runtime, loaded once -->
    <script src="https://unpkg.com/lucide@latest" is:inline></script>
  </head>
  <body class="bg-bg text-fg font-body antialiased">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />

    <script is:inline>
      if (window.lucide && typeof window.lucide.createIcons === "function") {
        window.lucide.createIcons()
      }

      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const reveal = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.classList.add("is-visible")
              reveal.unobserve(entry.target)
            }
          },
          { rootMargin: "0px 0px -8%", threshold: 0.12 },
        )
        document.querySelectorAll("[data-reveal]").forEach((element) => reveal.observe(element))
      }
    </script>
  </body>
</html>
