{
  "name": "sireno-deck-cli",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "sireno": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm --workspace-root run cli:dev",
    "test": "vitest run",
    "verify": "pnpm run test && pnpm run build",
    "dev:bundle": "tsdown --watch"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.0",
    "dbus-next": "^0.10.2",
    "execa": "^9.5.2",
    "js-yaml": "^4.1.0",
    "pino": "^9.0.0",
    "playwright": "^1.55.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0",
    "sharp": "^0.34.5",
    "systeminformation": "^5.31.6",
    "yargs": "^18.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "@types/react-reconciler": "^0.33.0",
    "@types/yargs": "^17.0.35",
    "oxfmt": "latest",
    "oxlint": "latest",
    "pino-pretty": "^13.0.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  }
}
