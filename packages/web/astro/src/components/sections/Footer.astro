---
/**
 * Footer — links, license, social.
 */
const year = new Date().getFullYear()
---

<footer class="py-16 px-6" style="background: #1a1f2a; border-top: 1px solid #2a3040;">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Brand -->
      <div>
        <p class="font-semibold text-base mb-3" style="color: #eef2f7;">
          Sireno Deck
        </p>
        <p class="text-sm leading-relaxed" style="color: #53738b;">
          Declarative Elgato Stream Deck control. Linux-first, dotfile-friendly,
          MIT licensed.
        </p>
      </div>

      <!-- Docs -->
      <div>
        <p class="text-xs font-semibold tracking-[0.15em] uppercase mb-4" style="color: #7dd3fc;">
          Documentation
        </p>
        <ul class="space-y-2">
          {
            [
              ["Install", "/docs/install/"],
              ["Architecture", "/docs/architecture/"],
              ["Theming", "/docs/theming/"],
              ["Addon authoring", "/docs/addon-authoring/"],
            ].map(([label, href]) => (
              <li>
                <a
                  href={href}
                  class="text-sm transition-colors"
                  style="color: #8a9bb5;"
                  onmouseover="this.style.color='#eef2f7';"
                  onmouseout="this.style.color='#8a9bb5';"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Project -->
      <div>
        <p class="text-xs font-semibold tracking-[0.15em] uppercase mb-4" style="color: #7dd3fc;">
          Project
        </p>
        <ul class="space-y-2">
          {
            [
              ["GitHub", "https://github.com/sireno-deck/sireno-deck"],
              ["npm", "https://npmjs.com/package/sirenodeck"],
              ["Issues", "https://github.com/sireno-deck/sireno-deck/issues"],
            ].map(([label, href]) => (
              <li>
                <a
                  href={href}
                  class="text-sm transition-colors"
                  style="color: #8a9bb5;"
                  target="_blank"
                  rel="noopener noreferrer"
                  onmouseover="this.style.color='#eef2f7';"
                  onmouseout="this.style.color='#8a9bb5';"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8"
      style="border-top: 1px solid #2a3040;"
    >
      <p class="text-xs" style="color: #53738b;">
        © {year} Sireno Deck · MIT License
      </p>
      <p class="text-xs" style="color: #53738b;">
        Built with Astro + Remotion
      </p>
    </div>
  </div>
</footer>
