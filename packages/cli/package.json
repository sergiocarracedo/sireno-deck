{
  "name": "@sirenodeck/cli",
  "version": "0.1.0-alpha.0",
  "description": "CLI for managing Elgato Stream Deck devices via a config-driven deck system.",
  "bugs": {
    "url": "https://github.com/sergiocarracedo/sireno-deck/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiocarracedo/sireno-deck.git",
    "directory": "packages/cli"
  },
  "bin": {
    "sirenodeck": "./bin/sirenodeck.js"
  },
  "files": [
    "bin",
    "dist/main.mjs",
    "src",
    "LICENSE",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__tests__/**",
    "!**/*.snap"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./react": {
      "types": "./src/api/react/index.ts",
      "default": "./src/api/react/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./src/vite/index.ts"
    },
    "./cli": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./ui/ButtonFrame": {
      "types": "./src/ui/ButtonFrame.tsx",
      "default": "./src/ui/ButtonFrame.tsx"
    },
    "./ui/surfaces/IconLabelSurface": {
      "types": "./src/ui/surfaces/IconLabelSurface.tsx",
      "default": "./src/ui/surfaces/IconLabelSurface.tsx"
    },
    "./ui/surfaces/IconLabelProgressSurface": {
      "types": "./src/ui/surfaces/IconLabelProgressSurface.tsx",
      "default": "./src/ui/surfaces/IconLabelProgressSurface.tsx"
    },
    "./ui/surfaces/TemporaryErrorSurface": {
      "types": "./src/ui/surfaces/TemporaryErrorSurface.tsx",
      "default": "./src/ui/surfaces/TemporaryErrorSurface.tsx"
    },
    "./ui/primitives/Label": {
      "types": "./src/ui/primitives/Label.tsx",
      "default": "./src/ui/primitives/Label.tsx"
    },
    "./ui/primitives/Text": {
      "types": "./src/ui/primitives/Text.tsx",
      "default": "./src/ui/primitives/Text.tsx"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node bin/dev.js",
    "start": "node --import tsx src/cli/main.ts",
    "build": "tsdown",
    "build:frontend": "vite --config frontend/vite.build.config.ts build",
    "build:emulator": "vite --config emulator/vite.build.config.ts build",
    "prepublishOnly": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "@elgato-stream-deck/node": "^7.6.3",
    "@meteocons/svg-static": "^0.1.0",
    "chokidar": "^5.0.0",
    "dbus-next": "^0.10.2",
    "execa": "^9.6.0",
    "get-windows": "^9.0.0",
    "pino": "^10.3.1",
    "playwright": "^1.50.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@types/yargs": "^17.0.35",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^25.0.1",
    "lucide-react": "^1.22.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4.0.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.22.4",
    "typescript": "7.0.1-rc",
    "vite": "^8.0.0",
    "vitest": "^4.1.9"
  }
}
