---
/**
 * Hero — top of the landing page.
 *
 * ShaderBackdrop lives in the section background. Foreground: tagline,
 * value-prop paragraph, and two CTAs. Below the CTA pair sits the looping
 * demo video frame.
 */
import HeroShader from "../hero/HeroShader.astro"
---

<section class="relative min-h-[100svh] flex flex-col items-center justify-center overflow-hidden px-6 pt-24 pb-16">
  <HeroShader />

  <div class="relative z-10 text-center max-w-4xl mx-auto">
    <p class="font-mono text-xs font-medium uppercase tracking-[0.25em] mb-6" style="color: var(--color-accent);">
      Your Stream Deck, your rules
    </p>

    <h1 class="font-display text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.05] mb-6">
      Declarative control for<br />
      <span style="background: linear-gradient(135deg, var(--color-accent), var(--color-accent-2)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        your Stream Deck
      </span>
    </h1>

    <p class="text-lg sm:text-xl max-w-2xl mx-auto mb-10" style="color: var(--color-muted);">
      A Node.js CLI that drives your Elgato Stream Deck from a single YAML config.
      Emulator, real hardware, and dev SPA — all from the same React interface.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mb-16">
      <a
        href="#install"
        class="px-7 py-3 rounded-lg text-sm font-semibold transition-all hover:-translate-y-0.5"
        style="background: var(--color-accent); color: var(--color-bg);"
      >
        Get Started
      </a>
      <a
        href="https://github.com/sergiocarracedo/sireno-deck"
        target="_blank"
        rel="noopener noreferrer"
        class="px-7 py-3 rounded-lg text-sm font-semibold transition-all"
        style="background: transparent; color: var(--color-fg); border: 1px solid var(--color-border);"
      >
        View on GitHub
        <i data-lucide="arrow-right" class="w-4 h-4 inline-block -mt-0.5 ml-1"></i>
      </a>
    </div>

    <div
      class="mx-auto max-w-3xl rounded-xl overflow-hidden relative aspect-video"
      style="background: var(--color-surface); border: 1px solid var(--color-border); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 0 1px var(--color-accent-glow);"
    >
      <video autoplay loop muted playsinline preload="auto" class="absolute inset-0 w-full h-full object-cover block" aria-label="Sireno Deck themes demo">
        <source src="/video-hero.webm" type="video/webm" />
      </video>
    </div>
  </div>
</section>
