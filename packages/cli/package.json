{
  "name": "sireno-deck-2",
  "version": "0.1.0",
  "private": true,
  "description": "CLI for managing Elgato Stream Deck devices via a config-driven deck system.",
  "bin": {
    "sireno": "./bin/sireno.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "default": "./src/vite/index.ts"
    }
  },
  "scripts": {
    "dev": "node bin/dev.js",
    "start": "node --import tsx src/cli/main.ts",
    "build": "echo 'no bundler in phase 0' && exit 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt src"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "@inquirer/prompts": "^7.0.0",
    "chokidar": "^5.0.0",
    "dbus-next": "^0.10.2",
    "execa": "^9.6.0",
    "get-windows": "^9.0.0",
    "pino": "^10.3.1",
    "playwright": "^1.50.0",
    "sharp": "^0.34.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@types/yargs": "^17.0.35",
    "oxfmt": "latest",
    "oxlint": "latest",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.22.4",
    "typescript": "7.0.1-rc",
    "vitest": "latest"
  }
}
