{
  "name": "sirenodeck-web",
  "version": "0.0.1",
  "private": true,
  "description": "Sireno Deck marketing site + documentation (Astro 5 + Starlight).",
  "type": "module",
  "scripts": {
    "sync-tokens": "node ../scripts/sync-tokens.mjs",
    "sync-docs": "node ./scripts/sync-cli-docs.mjs",
    "predev": "pnpm run sync-docs && pnpm run sync-tokens",
    "dev": "astro dev",
    "prebuild": "pnpm run sync-docs && pnpm run sync-tokens",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint src astro.config.mjs scripts",
    "format": "oxfmt src astro.config.mjs scripts",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.1.0",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.6.0"
  }
}
