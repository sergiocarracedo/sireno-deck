{
  "plugins": ["import", "typescript"],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.tsdown/**",
    "**/coverage/**",
    "packages/addon-pomodoro/**",
    "packages/addon-app-shortcuts/**",
    "packages/cli/bin/**"
  ],
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "ts": "never",
        "tsx": "never",
        "js": "always",
        "jsx": "never"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/frontend/**", "**/emulator/**"],
            "message": "Core packages/cli/src cannot import from frontend or emulator subprojects. Use the bridge (WS) for cross-process communication.",
            "exceptPaths": ["./packages/cli/src/index.ts"]
          },
          {
            "group": ["../../../../*"],
            "message": "Cross-folder imports beyond 3 levels up must use the @/ alias."
          }
        ]
      }
    ]
  }
}
