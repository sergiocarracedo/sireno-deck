{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "strict": true
  },
  "include": ["src/**/*", "vite.config.ts"]
}