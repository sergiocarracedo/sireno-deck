---
/**
 * AddonCard — single addon entry, used in /addons/ and the homepage.
 *
 * Shows only the information needed to decide whether to open the addon:
 * one preview image, identity, category, icon, tags, and a short description.
 *
 * Click navigates to /addons/[id]/.
 */
import { getEntry } from "astro:content"
import Icon from "./Icon.astro"

interface Props {
  id: string
}

const { id } = Astro.props
const entry = await getEntry("addons", id)
if (!entry) throw new Error(`addon ${id} not found`)

const data = entry.data as any
const { displayName, description, category, source, tags, icon } = data
const shots: string[] = data.screenshots?.length
  ? data.screenshots
  : data.screenshot
    ? [data.screenshot]
    : []
const preview = shots[0]
const kind = source === "cli" ? "built-in" : category === "official" ? "official" : "community"
const isCommunity = kind === "community"
const teaserDescription =
  description.length > 300 ? `${description.slice(0, 297)}...` : description
---

<a
  href={`/addons/${id}/`}
  class="group flex flex-col rounded-xl overflow-hidden transition-all duration-300 hover:-translate-y-1"
  style="background: var(--color-surface); border: 1px solid var(--color-border);"
  data-reveal
>
  {
    preview ? (
      <div class="aspect-[16/10] overflow-hidden" style="border-bottom: 1px solid var(--color-border);">
        <img src={preview} alt="" class="w-full h-full object-cover" loading="lazy" />
      </div>
    ) : (
      <div
        class="aspect-[16/10] flex items-center justify-center"
        style="background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-raised) 100%); border-bottom: 1px solid var(--color-border);"
      >
        <i data-lucide={icon} class="w-10 h-10" style="color: var(--color-accent); opacity: 0.4;" />
      </div>
    )
  }

  <div class="flex flex-col flex-1 p-5">
    <div class="flex items-center justify-between mb-2">
      <div class="flex items-center gap-3">
        <div
          class="w-10 h-10 rounded-lg flex items-center justify-center"
          style="background: var(--color-surface-raised);"
        >
          <i data-lucide={icon} class="w-5 h-5" style="color: var(--color-accent);"></i>
        </div>
        <h3 class="font-display text-base font-semibold text-fg">{displayName}</h3>
      </div>
      <span
        class="text-[0.6875rem] font-mono px-2 py-0.5 rounded"
        style={
           !isCommunity
            ? "background: rgba(34, 211, 238, 0.1); color: var(--color-accent);"
            : "background: rgba(167, 139, 250, 0.1); color: var(--color-accent-2);"
        }
      >
        {kind}
      </span>
    </div>

    <p class="text-sm leading-relaxed mb-3" style="color: var(--color-muted);">{teaserDescription}</p>

    <div class="flex items-center justify-between pt-3 mt-auto" style="border-top: 1px solid var(--color-border);">
      <div class="flex flex-wrap gap-1.5">
        {tags.map((t: string) => (
          <span class="text-[0.6875rem] font-mono px-1.5 py-0.5 rounded" style="background: var(--color-surface-raised); color: var(--color-muted);">
            {t}
          </span>
        ))}
      </div>
      <span class="text-fg opacity-0 group-hover:opacity-100 transition-opacity" style="color: var(--color-accent);">
        <Icon name="arrow-right" class="w-4 h-4" />
      </span>
    </div>

  </div>
</a>
