---
/**
 * FeatureCard — single card with icon, title, body, optional screenshot.
 *
 * Uses Tailwind utilities directly + CSS vars for colors. Hover lifts and
 * adds an accent top border.
 */
interface Props {
  icon: string
  title: string
  body: string
  screenshot?: string
  screenshotAlt?: string
  accent?: "cyan" | "violet"
}

const {
  icon,
  title,
  body,
  screenshot,
  screenshotAlt = "",
  accent = "cyan",
} = Astro.props

const accentColor = accent === "violet" ? "var(--color-accent-2)" : "var(--color-accent)"
---

<div
  class="group relative overflow-hidden rounded-xl p-8 transition-all duration-300 hover:-translate-y-1"
  style="background: var(--color-surface); border: 1px solid var(--color-border);"
>
  <span
    class="absolute top-0 left-0 right-0 h-0.5 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style={`background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));`}
  />
  <div
    class="w-12 h-12 rounded-lg flex items-center justify-center mb-6"
    style="background: var(--color-surface-raised);"
  >
    <i data-lucide={icon} class="w-6 h-6" style={`color: ${accentColor};`}></i>
  </div>
  <h3 class="font-display text-xl font-semibold mb-3 text-fg">{title}</h3>
  <p class="text-sm leading-relaxed" style="color: var(--color-muted);">{body}</p>
  {
    screenshot && (
      <div class="mt-6 rounded-lg overflow-hidden" style="border: 1px solid var(--color-border); aspect-ratio: 16 / 10;">
        <img src={screenshot} alt={screenshotAlt} class="w-full h-full object-cover" loading="lazy" />
      </div>
    )
  }
</div>