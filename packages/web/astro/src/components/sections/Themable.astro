---
/**
 * Themable — showcases Sireno Deck's theming capability.
 *
 * Shows two theme swatches side-by-side: the default dark theme and a
 * hypothetical light theme. Each swatch shows a mini deck with 3 buttons.
 */
---

<section class="py-28 px-6" style="background: #252b36;">
  <div class="max-w-6xl mx-auto text-center">
    <p
      class="text-xs font-semibold tracking-[0.2em] uppercase mb-4"
      style="color: #c4b5fd;"
    >
      Theming
    </p>
    <h2 class="text-4xl font-semibold mb-6" style="color: #eef2f7;">
      Make it yours.
    </h2>
    <p class="text-lg max-w-2xl mx-auto mb-20" style="color: #8a9bb5;">
      Tokens, fonts, CSS overrides, or full React component substitution.
      Sireno Deck's theme contract covers every pixel — or you can bring your
      own components entirely.
    </p>

    <!-- Theme swatches -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Default dark theme -->
      <div
        class="rounded-2xl p-6 text-left"
        style="background: #2e3540; border: 1px solid #3a4050;"
      >
        <div class="mb-4">
          <p class="text-xs font-semibold mb-1" style="color: #7dd3fc;">
            Default Dark
          </p>
          <p class="text-xs" style="color: #53738b;">The built-in dark theme</p>
        </div>
        <!-- Mini deck -->
        <div
          class="rounded-xl p-3 inline-flex gap-2"
          style="background: #1a1f2a;"
        >
          {
            [
              { bg: "#2a3346", text: "#eef2f7", label: "Mute" },
              { bg: "#1f6b5e", text: "#c3f5ff", label: "♫" },
              { bg: "#2a3346", text: "#eef2f7", label: "OBS" },
            ].map((btn) => (
              <div
                class="w-12 h-12 rounded-lg flex items-center justify-center text-xs font-semibold"
                style={`background: ${btn.bg}; color: ${btn.text};`}
              >
                {btn.label}
              </div>
            ))
          }
        </div>
        <!-- Color tokens -->
        <div class="mt-4 flex flex-wrap gap-2">
          {
            ["#2e3540", "#53738b", "#7dd3fc", "#c3f5ff", "#34d399"].map(
              (c) => (
                <div
                  class="w-6 h-6 rounded-md"
                  style={`background: ${c};`}
                  title={c}
                />
              ),
            )
          }
        </div>
      </div>

      <!-- Hypothetical light theme -->
      <div
        class="rounded-2xl p-6 text-left"
        style="background: #f0f2f5; border: 1px solid #d0d5e0;"
      >
        <div class="mb-4">
          <p class="text-xs font-semibold mb-1" style="color: #2563eb;">
            Light Panel
          </p>
          <p class="text-xs" style="color: #6b7280;">
            Custom community theme
          </p>
        </div>
        <!-- Mini deck -->
        <div
          class="rounded-xl p-3 inline-flex gap-2"
          style="background: #e4e7ed;"
        >
          {
            [
              { bg: "#dbeafe", text: "#1e40af", label: "Mute" },
              { bg: "#d1fae5", text: "#065f46", label: "♫" },
              { bg: "#dbeafe", text: "#1e40af", label: "OBS" },
            ].map((btn) => (
              <div
                class="w-12 h-12 rounded-lg flex items-center justify-center text-xs font-semibold"
                style={`background: ${btn.bg}; color: ${btn.text};`}
              >
                {btn.label}
              </div>
            ))
          }
        </div>
        <!-- Color tokens -->
        <div class="mt-4 flex flex-wrap gap-2">
          {
            ["#f0f2f5", "#d0d5e0", "#2563eb", "#7dd3fc", "#059669"].map(
              (c) => (
                <div
                  class="w-6 h-6 rounded-md"
                  style={`background: ${c};`}
                  title={c}
                />
              ),
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
