---
/**
 * InstallSection — CTA + quick install, split by OS.
 *
 * The recommended distribution per OS is shown in an OS tab switcher.
 * Packaged builds (Flathub / DMG / MSI) are the target distribution; until
 * they publish, the pnpm one-liner is the current path on every OS.
 */

const osTabs = [
  {
    id: "linux",
    label: "Linux",
    recommended: "flatpak install flathub dev.sireno-deck.SirenoDeck",
    note: "Flathub package (recommended). Sandboxed, auto-updating.",
    planned: true,
  },
  {
    id: "macos",
    label: "macOS",
    recommended: "brew install --cask sirenodeck",
    note: "Native DMG / Homebrew cask (recommended).",
    planned: true,
  },
  {
    id: "windows",
    label: "Windows",
    recommended: "winget install sireno-deck",
    note: "MSI installer via winget (recommended).",
    planned: true,
  },
]

const steps = [
  {
    step: 1,
    label: "Run",
    code: "pnpm dlx sirenodeck start --emulator",
    note: "Opens the emulator in your browser. No real hardware needed. Works on every OS today.",
  },
  {
    step: 2,
    label: "Configure",
    code: "sireno config edit",
    note: "Opens config.yml in your $EDITOR. Restart to apply changes.",
  },
  {
    step: 3,
    label: "Go",
    code: "sireno start",
    note: "Daemon starts. Press any button on the Stream Deck or emulator.",
  },
]
---

<section
  id="install"
  class="px-6 py-24 text-center"
  style="background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%); border-top: 1px solid var(--color-border);"
>
  <div class="max-w-3xl mx-auto">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] mb-4" style="color: var(--color-accent);">
      Get started
    </p>
    <h2 class="font-display text-4xl sm:text-5xl font-bold mb-4 text-fg">
      Up in 60 seconds
    </h2>
    <p class="text-lg mb-10" style="color: var(--color-muted);">
      Pick your OS. Packaged builds are on the way — the pnpm one-liner works on every platform today.
    </p>

    {/* OS tab switcher */}
    <div class="flex flex-wrap items-center justify-center gap-2 mb-6">
      {osTabs.map((tab) => (
        <button
          type="button"
          data-os-tab={tab.id}
          class="os-tab px-4 py-2 rounded-md text-sm font-medium transition-colors"
          style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);"
        >
          {tab.label}
        </button>
      ))}
    </div>

    {osTabs.map((tab) => (
      <div
        data-os-panel={tab.id}
        class="os-panel mb-8 hidden rounded-xl overflow-hidden text-left"
        style="background: var(--color-bg); border: 1px solid var(--color-border);"
      >
        <div class="flex items-center gap-2 px-6 pt-5 pb-3">
          <p class="text-sm font-semibold text-fg">Recommended · {tab.label}</p>
          {tab.planned && (
            <span class="text-[0.6875rem] font-mono px-2 py-0.5 rounded" style="background: rgba(167, 139, 250, 0.1); color: var(--color-accent-2);">
              coming soon
            </span>
          )}
        </div>
        <div class="px-6">
          <div class="rounded-md px-4 py-2.5 font-mono text-sm overflow-x-auto" style="background: var(--color-surface); color: var(--color-accent);">
            {tab.recommended}
          </div>
        </div>
        <div class="px-6 pt-3 pb-5 text-xs" style="color: var(--color-muted);">{tab.note}</div>
      </div>
    ))}

    {/* Current quick-start path */}
    <div class="flex flex-col gap-4 text-left">
      {
        steps.map((s) => (
          <div class="rounded-xl overflow-hidden" style="background: var(--color-bg); border: 1px solid var(--color-border);">
            <div class="flex items-center gap-4 px-6 py-4">
              <div
                class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0"
                style="background: var(--color-accent); color: var(--color-bg);"
              >
                {s.step}
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold mb-2 text-fg">{s.label}</p>
                <div class="rounded-md px-4 py-2.5 font-mono text-sm overflow-x-auto" style="background: var(--color-surface); color: var(--color-accent);">
                  {s.code}
                </div>
              </div>
            </div>
            <div class="px-6 pb-4 text-xs" style="color: var(--color-muted);">
              {s.note}
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-12">
      <a
        href="https://github.com/sergiocarracedo/sireno-deck"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-lg text-sm font-semibold"
        style="background: var(--color-accent); color: var(--color-bg);"
      >
        GitHub
      </a>
      <a
        href="/user/installation/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold"
        style="background: transparent; color: var(--color-fg); border: 1px solid var(--color-border);"
      >
        Documentation
        <i data-lucide="book-open" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const tabs = document.querySelectorAll("[data-os-tab]")
    const panels = document.querySelectorAll("[data-os-panel]")
    let current = "linux"

    const activate = (id) => {
      current = id
      tabs.forEach((t) => {
        const active = t.getAttribute("data-os-tab") === id
        t.style.background = active ? "var(--color-surface-raised)" : "var(--color-surface)"
        t.style.color = active ? "var(--color-fg)" : "var(--color-muted)"
        t.style.borderColor = active ? "var(--color-accent)" : "var(--color-border)"
      })
      panels.forEach((p) => {
        p.classList.toggle("hidden", p.getAttribute("data-os-panel") !== id)
      })
    }

    tabs.forEach((t) => t.addEventListener("click", () => activate(t.getAttribute("data-os-tab") || "linux")))
    activate(current)
  })()
</script>