{
  "kind": "theme",
  "apiVersion": 1,
  "name": "light",
  "version": "0.1.0",
  "description": "Light theme for Sireno Deck.",
  "colorTokens": {
    "background": "#f5f7fa",
    "frame": "#9eb4c5",
    "foreground": "#1a202c",
    "foreground-contrast": "#fafafa",
    "primary": "#0284c7",
    "accent": "#075985",
    "success": "#059669",
    "danger": "#dc2626",
    "tintBlue": "#0284c7",
    "tintGreen": "#059669",
    "tintPurple": "#7c3aed"
