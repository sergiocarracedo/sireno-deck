---
/**
 * NavigationSection — visual demo of the deck hierarchy.
 *
 * Decks form a tree (Main → sub-decks → sub-sub-decks …) but navigation is
 * always linear: from any deck you can move to the next deck in the current
 * branch, or back to the previous one. Holding back returns you to Main.
 * The same rules apply to overlay decks.
 */
import SectionHeader from "../SectionHeader.astro"
---

<section id="navigation" class="px-6 py-24" style="background: var(--color-surface);">
  <div class="max-w-6xl mx-auto">
    <SectionHeader
      eyebrow="Navigation"
      title="Intuitive deck hierarchy"
      body="Decks are organised as a tree, but navigation stays linear — at any deck you can move to the next deck in the current branch or go back to the previous one."
      accent="violet"
    />

    <div
      class="rounded-2xl p-10"
      style="background: var(--color-surface-raised); border: 1px solid var(--color-border);"
    >
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div>
          <h3 class="font-display text-2xl font-semibold mb-4 text-fg">A tree of decks, linear navigation</h3>
          <ul class="space-y-3 text-sm leading-relaxed" style="color: var(--color-muted);">
            <li>
              Decks form a <strong class="text-fg">tree</strong>: a deck can have
              sub-decks, and a sub-deck can have its own sub-decks.
            </li>
            <li>
              You navigate <strong class="text-fg">linearly</strong> along the
              current branch — tap into the next deck level, or back to the
              previous one.
            </li>
            <li>
              <strong class="text-fg">Hold the back button</strong> from any
              sub-deck to return straight to Main.
            </li>
            <li>
              The same rules apply to <strong class="text-fg">overlay decks</strong> —
              they follow their own branch and return to the deck that was
              active before the overlay appeared.
            </li>
          </ul>
        </div>

        <div class="rounded-xl p-6" style="background: var(--color-bg); border: 1px solid var(--color-border);">
          <p class="font-mono text-xs uppercase tracking-widest mb-4" style="color: var(--color-accent);">Deck tree</p>
          <pre class="font-mono text-sm leading-loose text-fg">Main
├── Deck 1
│   └── Deck 3
└── Deck 2
    ├── Deck 4
    │   └── Deck 5
    └── Deck 6</pre>
          <p class="font-mono text-xs mt-4" style="color: var(--color-muted);">
            Any point → next level or previous · hold back → Main
          </p>
        </div>
      </div>
    </div>
  </div>
</section>