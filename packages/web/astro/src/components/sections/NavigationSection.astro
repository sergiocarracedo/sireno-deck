---
/**
 * NavigationSection — visual demo of the deck hierarchy.
 *
 * Mock flow `Main → App Shortcuts → Discord Overlay` over the deck image.
 */
import SectionHeader from "../SectionHeader.astro"
---

<section id="navigation" class="px-6 py-24" style="background: var(--color-surface);">
  <div class="max-w-6xl mx-auto">
    <SectionHeader
      eyebrow="Navigation"
      title="Intuitive deck hierarchy"
      body="Navigate between decks with back buttons and a slot system. Each deck has its own independent navigation stack."
      accent="violet"
    />

    <div
      class="rounded-2xl p-10 grid gap-8 items-center"
      style="background: var(--color-surface-raised); border: 1px solid var(--color-border);"
    >
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div>
          <h3 class="font-display text-2xl font-semibold mb-4 text-fg">Navigation flow</h3>
          <p class="mb-6" style="color: var(--color-muted);">
            From the main deck you can access any sub-deck. Overlays maintain their own
            independent navigation and automatically return to the previous deck when you
            close the app.
          </p>
          <div class="flex flex-wrap items-center gap-3">
            <span class="font-mono text-sm px-4 py-2 rounded-md" style="background: var(--color-bg); border: 1px solid var(--color-border);">Main</span>
            <i data-lucide="arrow-right" class="w-5 h-5" style="color: var(--color-accent);"></i>
            <span class="font-mono text-sm px-4 py-2 rounded-md" style="background: var(--color-bg); border: 1px solid var(--color-border);">App Shortcuts</span>
            <i data-lucide="arrow-right" class="w-5 h-5" style="color: var(--color-accent);"></i>
            <span class="font-mono text-sm px-4 py-2 rounded-md" style="background: var(--color-bg); border: 1px solid var(--color-border);">Discord Overlay</span>
          </div>
        </div>
        <div class="rounded-xl overflow-hidden" style="border: 1px solid var(--color-border);">
          <img src="/captures/05-date-time.png" alt="Deck hierarchy in Sireno Deck" class="w-full block" />
        </div>
      </div>
    </div>
  </div>
</section>