---
/**
 * /themes/[slug]/ — theme detail page.
 *
 * Built-in themes show palette + mini-deck + a one-line `theme:` usage
 * snippet. No "Source" section (they ship inside the CLI).
 * Third-party themes additionally get an Install block with repo link.
 */
import Layout from "../../layouts/Base.astro"
import ShaderBackdrop from "../../components/ShaderBackdrop.astro"
import PaletteSwatches from "../../components/PaletteSwatches.astro"
import Icon from "../../components/Icon.astro"
import { getCollection, getEntry } from "astro:content"
import CommandTabs from "../../components/CommandTabs.astro"

export async function getStaticPaths() {
  const themes = await getCollection("themes")
  return themes.map((t) => ({ params: { slug: t.id }, props: { id: t.id } }))
}

const { id } = Astro.props
const entry = await getEntry("themes", id)
if (!entry) throw new Error(`theme ${id} not found`)
const t = entry.data
const themeId = entry.id
const isOfficial = t.category === "official"
---

<Layout
  title={`${t.displayName} Theme — Sireno Deck`}
  description={t.description}
  ogImage={t.preview}
>
  <section class="relative px-6 pt-32 pb-16 overflow-hidden">
    <ShaderBackdrop variant="page" />
    <div class="relative max-w-5xl mx-auto">
      <a href="/themes/" class="inline-flex items-center gap-1 text-xs mb-6" style="color: var(--color-muted);">
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        Back to registry
      </a>

      <div class="flex items-start justify-between gap-6 mb-6 flex-wrap">
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="font-display text-4xl font-bold text-fg">{t.displayName}</h1>
            <span
              class="text-xs font-mono px-2 py-0.5 rounded"
              style={isOfficial
                ? "background: rgba(34, 211, 238, 0.1); color: var(--color-accent);"
                : "background: rgba(167, 139, 250, 0.1); color: var(--color-accent-2);"}
            >
              {isOfficial ? "official" : "community"}
            </span>
          </div>
          <p class="text-lg max-w-2xl" style="color: var(--color-muted);">{t.description}</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-10">
        {t.tags.map((tag: string) => (
          <span class="text-xs font-mono px-2 py-1 rounded" style="background: var(--color-surface-raised); color: var(--color-muted);">{tag}</span>
        ))}
      </div>

      <div class="rounded-xl overflow-hidden mb-12" style="border: 1px solid var(--color-border); aspect-ratio: 16 / 9;">
        {t.preview ? (
          <img src={t.preview} alt={`${t.displayName} preview`} class="w-full h-full object-cover" />
        ) : (
          <div class="w-full h-full flex items-center justify-center" style={`background: ${t.palette.background};`}>
            <div class="w-48 h-16 rounded-lg" style={`background: ${t.palette.primary}; box-shadow: 0 0 40px ${t.palette.primary}99;`}></div>
          </div>
        )}
      </div>

      {/* Custom themes concept — how a theme customizes the deck */}
      <div class="mb-10 rounded-xl p-6" style="background: var(--color-surface); border: 1px solid var(--color-accent);">
        <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-3" style="color: var(--color-accent);">
          Custom themes
        </p>
        <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
          Custom themes allow you to change the theme just by defining the new
          color tokens in a manifest file (YAML) — but you can also override the
          React primitive UI components for deeper customization. Start with
          tokens for a quick restyle, then drop in your own components when you
          need pixel-level control.
        </p>
      </div>

      <div class="grid lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 rounded-xl p-6" style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <h2 class="font-display text-lg font-semibold mb-4">Palette</h2>
          <PaletteSwatches palette={t.palette} />

          <h2 class="font-display text-lg font-semibold mt-8 mb-4">Mini deck preview</h2>
          <div class="rounded-xl p-3 inline-flex gap-2" style={`background: ${t.palette.background}; border: 1px solid ${t.palette.frame};`}>
            {[
              { bg: t.palette.frame, fg: t.palette.foreground, label: "Mute" },
              { bg: t.palette.primary, fg: t.palette.foreground, label: "♫" },
              { bg: t.palette.accent, fg: t.palette.foreground, label: "OBS" },
            ].map((btn) => (
              <div
                class="w-14 h-14 rounded-md flex items-center justify-center text-xs font-semibold"
                style={`background: ${btn.bg}; color: ${btn.fg};`}
              >
                {btn.label}
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-xl p-6 flex flex-col gap-6" style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <h2 class="font-display text-lg font-semibold mb-0">Usage</h2>

          {/* Non-builtin themes (npm-installable) get the install tabs even when
      official — e.g. riptide / neon-grids ship as separate packages. */}
          {isOfficial && !t.npm ? (
            <>
              <p class="text-sm leading-relaxed -mt-3" style="color: var(--color-muted);">
                Official theme from this repository. Reference it from your
                <code class="font-mono text-xs px-1 py-0.5 rounded" style="background: var(--color-bg);">config.yml</code>:
              </p>
              <pre class="rounded-md p-3 text-xs font-mono overflow-x-auto" style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-fg);"><code>theme: {themeId}</code></pre>
            </>
          ) : (
            <>
              {t.repo && (
                <p class="text-sm leading-relaxed -mt-3">
                  <a href={t.repo} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 transition-colors hover:text-fg" style="color: var(--color-muted);">
                    <i data-lucide="github" class="w-4 h-4"></i>
                    Source on GitHub
                  </a>
                </p>
              )}
                            <p class="text-sm leading-relaxed -mt-3" style="color: var(--color-muted);">
                Community theme. Install it, then reference it from your
                <code class="font-mono text-xs px-1 py-0.5 rounded" style="background: var(--color-bg);">config.yml</code>:
              </p>
              {t.npm && (
                <CommandTabs
                  pnpm={`pnpm add -g ${t.npm}`}
                  npm={`npm i -g ${t.npm}`}
                  yarn={`yarn global add ${t.npm}`}
                  label={`Install ${t.displayName}`}
                />
              )}
              <pre class="rounded-md p-3 text-xs font-mono overflow-x-auto" style="background: var(--color-bg); border: 1px solid var(--color-border); color: var(--color-fg);"><code>{`theme: ${t.npm ?? `./packages/themes/${themeId}`}`}</code></pre>
              <p class="text-xs" style="color: var(--color-muted);">
                Any string that isn't a registered theme or filesystem path is
                resolved as an npm package — see
                <a href="/developer/theme-authoring/" class="underline">theme authoring</a>.
              </p>
            </>
          )}
        </div>
      </div>
    </div>
  </section>
</Layout>
