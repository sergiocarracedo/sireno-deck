{
  "plugins": ["import"],
  "ignorePatterns": ["packages/cli/fixtures/**"],
  "rules": {
    "import/extensions": [
      "error",
      "ignorePackages",
      {
        "ts": "never",
        "tsx": "never",
        "js": "never",
        "jsx": "never"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["../../../*", "../../../../*"],
            "message": "Cross-folder imports beyond 2 levels up must use the @/ alias (see AGENTS.md Import Conventions)."
          }
        ]
      }
    ]
  }
}
