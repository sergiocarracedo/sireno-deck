---
/**
 * Addons — showcases built-in and community addons.
 */
const builtIns = [
  {
    name: "app-shortcuts",
    description: "Launch or focus any application with a single tap.",
    tag: "Built-in",
    tagStyle: "background: #1f3a4d; color: #7dd3fc;",
  },
  {
    name: "pomodoro",
    description: "25 / 5 / 15 minute pomodoro timer with progress bars.",
    tag: "Built-in",
    tagStyle: "background: #1f3a4d; color: #7dd3fc;",
  },
  {
    name: "key-macro",
    description: "Send keystrokes, chorded combos, and key repeat to any window.",
    tag: "Built-in",
    tagStyle: "background: #1f3a4d; color: #7dd3fc;",
  },
]

const community = [
  {
    name: "sireno-theme-matrix",
    description: "A 1980s terminal aesthetic with phosphor-green on black.",
    tag: "Community",
    tagStyle: "background: #2a1f4d; color: #c4b5fd;",
  },
  {
    name: "sireno-deck-homeassistant",
    description: "Control lights, climate, and scenes in Home Assistant.",
    tag: "Community",
    tagStyle: "background: #2a1f4d; color: #c4b5fd;",
  },
]
---

<section class="py-28 px-6" style="background: #2e3540;">
  <div class="max-w-6xl mx-auto">
    <p
      class="text-xs font-semibold tracking-[0.2em] uppercase mb-4 text-center"
      style="color: #c3f5ff;"
    >
      Addons
    </p>
    <h2 class="text-4xl font-semibold text-center mb-6" style="color: #eef2f7;">
      Everything you need. Room to grow.
    </h2>
    <p class="text-center text-lg mb-16 max-w-2xl mx-auto" style="color: #8a9bb5;">
      Built-in addons ship with the core. The addon API lets anyone publish
      themes and backends to npm.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {
        [
          ...builtIns.map((a) => ({ ...a, builtIn: true })),
          ...community.map((a) => ({ ...a, builtIn: false })),
        ].map((addon) => (
          <div
            class="rounded-xl p-6 flex flex-col gap-3"
            style="background: #252b36; border: 1px solid #3a4050;"
          >
            <div class="flex items-center justify-between">
              <code
                class="text-sm font-semibold"
                style="color: #eef2f7;"
              >
                {addon.name}
              </code>
              <span
                class="text-xs px-2 py-0.5 rounded-full font-semibold"
                style={addon.tagStyle}
              >
                {addon.tag}
              </span>
            </div>
            <p class="text-sm leading-relaxed" style="color: #8a9bb5;">
              {addon.description}
            </p>
          </div>
        ))
      }

      <!-- "Your addon here" card -->
      <div
        class="rounded-xl p-6 flex flex-col items-center justify-center text-center gap-3"
        style="background: #252b36; border: 1.5px dashed #3a4050;"
      >
        <div class="text-2xl" style="color: #53738b;" aria-hidden="true">
          +
        </div>
        <p class="text-sm" style="color: #53738b;">
          Publish your addon to npm
        </p>
        <a
          href="/docs/addon-authoring/"
          class="text-xs font-semibold underline"
          style="color: #7dd3fc;"
        >
          Read the addon guide →
        </a>
      </div>
    </div>
  </div>
</section>
