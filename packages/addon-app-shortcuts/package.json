{
  "name": "@sirenodeck/addon-app-shortcuts",
  "version": "0.1.0",
  "description": "Overlay decks for VS Code, OpenCode, Chrome, Claude Code, Slack, Teams, Discord, and Google Meet",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
