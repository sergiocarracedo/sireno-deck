---
/**
 * FeaturesSection — three flagship cards: Overlay Decks, Addons & Themes,
 * Coding Agents.
 */
import SectionHeader from "../SectionHeader.astro"
import FeatureCard from "../FeatureCard.astro"

const features = [
  {
    icon: "layers",
    title: "Overlay Decks",
    body: "Contextual decks that appear automatically when you switch applications. Your main deck stays intact while an app-specific overlay takes over temporarily. Overlays maintain their own navigation and return to the previous deck when you close the app.",
    images: [
      "/captures/overlay-vscode.png",
      "/captures/overlay-chrome.png",
      "/captures/overlay-slack.png",
      "/captures/overlay-discord.png",
      "/captures/overlay-teams.png",
      "/captures/overlay-opencode.png",
      "/captures/overlay-claude-code.png",
      "/captures/overlay-google-meet.png",
    ],
    imagesAlt: "Overlay deck preview",
    links: [{ label: "Overlay deck guide", href: "/user/configuration-files/#overlay-deck" }],
  },
  {
    icon: "puzzle",
    title: "Addons & Themes",
    body: "Extend Sireno Deck with installable addons and custom themes. Addons contribute button types and generated decks; themes customize the deck's visual style.",
    images: [
      "/captures/web-snapshot-color-blue.png",
      "/captures/web-snapshot-color-green.png",
      "/captures/web-snapshot-color-purple.png",
      "/captures/web-snapshot-color-cyan.png",
      "/captures/web-snapshot-color-magenta.png",
      "/captures/web-snapshot-color-amber.png",
      "/captures/web-snapshot-color-lime.png",
    ],
    imagesAlt: "Tinted deck preview",
    links: [
      { label: "Browse addons", href: "/addons/" },
      { label: "Browse themes", href: "/themes/" },
    ],
  },
  {
    icon: "bot",
    title: "Coding Agents",
    body: "Monitor OpenCode and Claude Code sessions from the deck. See status counts, open a generated deck of session tiles, and inspect session details. Preview uses illustrative sessions.",
    images: [
      "/media/captures/coding-agents-summary.png",
      "/media/captures/coding-agents-deck.png",
    ],
    imagesAlt: "Illustrative coding agent summary and session details",
    accent: "violet" as const,
    links: [{ label: "Overlay deck guide", href: "/user/configuration-files/#overlay-deck" }],
  },
]
---

<section id="features" class="px-6 py-24">
  <div class="max-w-6xl mx-auto">
    <SectionHeader
      eyebrow="Features"
      title="Power up your workflow"
      body="Three execution surfaces from the same codebase: browser emulator, real hardware, and Vite-powered development SPA."
    />

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6" data-reveal-group>
      {features.map((f) => <FeatureCard {...f} />)}
    </div>
  </div>
</section>
