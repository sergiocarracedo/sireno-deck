---
/**
 * Video — wrapper for <video> with Sireno-safe defaults.
 * For Phase D this will be replaced with the Remotion-rendered HeroLoop.mp4.
 */
interface Props {
  src: string
  class?: string
  autoplay?: boolean
  loop?: boolean
  muted?: boolean
  playsInline?: boolean
}

const {
  src,
  class: className = "",
  autoplay = true,
  loop = true,
  muted = true,
  playsInline = true,
} = Astro.props
---

<video
  src={src}
  class={`w-full h-full object-cover ${className}`}
  autoplay={autoplay}
  loop={loop}
  muted={muted}
  playsinline={playsInline}
  aria-hidden="true"
>
</video>
