  "fonts": [
    {
      "fontFamily": "Bitcount Single",
      "fontWeight": 400,
      "fontStyle": "normal",
      "src": "./assets/Bitcount_Single/BitcountSingle-VariableFont_wght.woff2",
      "axes": {
        "weight": [300, 800]
      }
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 500,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Medium.ttf"
