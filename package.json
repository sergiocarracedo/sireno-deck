{
  "name": "sireno-deck-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "cli:build:tailwind-browser": "pnpm --filter sireno-deck-cli run build:tailwind-browser",
    "cli:dev": "pnpm exec tsx watch --include \"./packages/cli/src/cli/dev-watch.ts\" --include \"./packages/cli/src/cli/commands/start.ts\" --include \"./config.yml\" packages/cli/src/cli/dev-watch.ts",
    "dev": "pnpm run cli:dev",
    "lint": "oxlint packages/",
    "format": "oxfmt packages/",
    "test": "vitest run",
    "verify": "pnpm --filter sireno-deck-cli verify"
  },
  "devDependencies": {
    "vitest": "^3.0.0"
  }
}
