{
  "id": "io.sireno.SirenoDeck",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "sirenodeck",
  "build-options": {
    "build-args": ["--share=network"]
  },
  "finish-args": [
    "--device=all",
    "--socket=wayland",
    "--socket=x11",
    "--share=ipc",
    "--share=network",
    "--filesystem=home",
    "--socket=pulseaudio"
  ],
  "modules": [
    {
      "name": "sireno-deck",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/sireno",
        "cp -a sireno/. /app/sireno/",
        "install -Dm755 sireno/sirenodeck /app/bin/sirenodeck",
        "install -Dm644 sireno/etc/install.json /app/share/metainfo/install.json"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../dist/staging/sireno-linux-x64"
        }
      ]
    }
  ]
}
