  },
  "fonts": [
    {
      "fontFamily": "IBM Plex Sans",
      "fontWeight": 100,
      "fontStyle": "normal",
      "src": "./assets/static/IBMPlexSans-Thin.ttf"
    },
    {
      "fontFamily": "IBM Plex Sans",
      "fontWeight": 300,
      "fontStyle": "normal",
      "src": "./assets/static/IBMPlexSans-Light.ttf"
    },
    {
      "fontFamily": "IBM Plex Sans",
      "fontWeight": 300,
      "fontStyle": "italic",
      "src": "./assets/static/IBMPlexSans-LightItalic.ttf"
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 300,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Regular.ttf"
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 500,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Medium.ttf"
