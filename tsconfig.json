{
  "compilerOptions": {
    "target": "ES2022",
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./packages/cli/src/*"],
      "sireno-deck-cli": ["./packages/cli/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
