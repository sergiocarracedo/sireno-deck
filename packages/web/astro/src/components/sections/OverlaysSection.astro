---
/**
 * OverlaysSection — carousel of per-app overlay decks.
 *
 * Each overlay deck appears when its app gains focus. The carousel
 * cycles through VS Code, Chrome, Slack, Discord, Teams, OpenCode,
 * Claude Code, and Google Meet — the eight app-shortcuts decks.
 */
import DeckCarousel from "../carousel/DeckCarousel.astro"

const slides = [
  {
    id: "overlay-vscode",
    imageSrc: "/captures/overlay-vscode.png",
    eyebrow: "VS Code",
    title: "Your editor, your shortcuts.",
    body: "Palette, quick open, terminal — the commands you reach for a hundred times a day, already on the deck.",
  },
  {
    id: "overlay-chrome",
    imageSrc: "/captures/overlay-chrome.png",
    eyebrow: "Chrome",
    title: "Browse without the hunt.",
    body: "Tabs, dev tools, and the omnibox — one tap instead of a chord.",
  },
  {
    id: "overlay-slack",
    imageSrc: "/captures/overlay-slack.png",
    eyebrow: "Slack",
    title: "Stay in the flow.",
    body: "Channels, threads, and quick reactions without leaving your keyboard.",
  },
  {
    id: "overlay-discord",
    imageSrc: "/captures/overlay-discord.png",
    eyebrow: "Discord",
    title: "Voice and chat, zero context switch.",
    body: "Mute, deafen, and server-hop from the deck — no window shuffle.",
  },
  {
    id: "overlay-teams",
    imageSrc: "/captures/overlay-teams.png",
    eyebrow: "Teams",
    title: "Meetings, simplified.",
    body: "Mute, leave, and share — the meeting controls you actually use, already on the deck.",
  },
  {
    id: "overlay-opencode",
    imageSrc: "/captures/overlay-opencode.png",
    eyebrow: "OpenCode",
    title: "Agents at your fingertips.",
    body: "Start, stop, and steer your coding agents without leaving the editor.",
  },
  {
    id: "overlay-claude-code",
    imageSrc: "/captures/overlay-claude-code.png",
    eyebrow: "Claude Code",
    title: "Pair program, physically.",
    body: "Claude's shortcuts and session controls, right next to your hands.",
  },
  {
    id: "overlay-google-meet",
    imageSrc: "/captures/overlay-google-meet.png",
    eyebrow: "Google Meet",
    title: "Meet, muted and ready.",
    body: "Join, leave, and mute — the meet essentials, always where you expect them.",
  },
]
---

<section class="relative py-28 px-6" style="background: var(--color-surface);">
  <div class="mx-auto max-w-5xl">
    <header class="mx-auto max-w-2xl text-center mb-12">
      <p class="text-xs font-semibold tracking-[0.25em] uppercase mb-3" style="color: var(--color-accent);">
        Overlay decks
      </p>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.05] text-fg">The deck follows the app.</h2>
      <p class="mt-5 text-base leading-relaxed" style="color: var(--color-muted);">
        Switch to an app and its deck appears. Close it and you're back where you were.
      </p>
    </header>
    <DeckCarousel slides={slides} />
  </div>
</section>