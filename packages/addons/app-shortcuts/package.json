{
  "name": "@sirenodeck/addon-app-shortcuts",
  "version": "0.1.0",
  "description": "Overlay decks for VS Code, OpenCode, Chrome, Claude Code, Slack, Teams, Discord, and Google Meet",
  "bugs": {
    "url": "https://github.com/sergiocarracedo/sireno-deck/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiocarracedo/sireno-deck.git",
    "directory": "packages/addons/app-shortcuts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
