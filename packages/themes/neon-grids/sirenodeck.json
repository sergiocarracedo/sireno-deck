{
  "kind": "theme",
  "apiVersion": 1,
  "name": "neon-grids",
  "version": "0.1.0",
  "description": "Synthwave theme: black background, electric-cyan primary with magenta/pink contrast, deck-wide perspective grid, neon-line icons on purple radial.",
  "colorTokens": {
    "background": "#000000",
    "frame": "#ff00ff",
    "foreground": "#ff5fd0",
    "foreground-contrast": "#ffffff",
    "primary": "#00e5ff",
    "accent": "#8a2be2",
    "success": "#00ff9f",
    "danger": "#ff003c"
  },
  "variants": {
    "default": {
      "background": "#000000",
      "border": "#00e5ff",
      "foreground": "#ff5fd0"
    },
    "highlighted": {
      "background": "#00d4ff40",
      "border": "#00d4ff8c",
      "foreground": "#ff5fd0"
    },
    "warning": {
      "background": "#8a2be240",
      "border": "#8a2be28c",
      "foreground": "#ff5fd0"
    },
    "success": {
      "background": "#00ff9f40",
      "border": "#00ff9f8c",
      "foreground": "#ff5fd0"
    },
    "error": {
      "background": "#ff003c40",
      "border": "#ff003c8c",
      "foreground": "#ff003c"
    }
  },
  "typography": {
    "main_text": {
      "fontFamily": "Unica One",
      "fontSize": 12,
      "fontWeight": 400,
      "letterSpacing": 0.4
    },
    "auxiliary_text": {
      "fontFamily": "IBM Plex Mono",
      "fontSize": 8,
      "fontWeight": 700,
      "letterSpacing": 1.6
    },
    "monospace": {
      "fontFamily": "IBM Plex Mono",
      "fontSize": 10,
      "fontWeight": 400,
      "letterSpacing": 0.4
    }
  },
  "fonts": [
    {
      "fontFamily": "Unica One",
      "fontWeight": 400,
      "fontStyle": "normal",
      "src": "./assets/Unica_One/UnicaOne-Regular.ttf"
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 300,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Regular.ttf"
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 400,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Regular.ttf"
    },
    {
      "fontFamily": "IBM Plex Mono",
      "fontWeight": 700,
      "fontStyle": "normal",
      "src": "./assets/IBM_Plex_Mono/IBMPlexMono-Bold.ttf"
    }
  ],
  "assets": {
    "styles": ["./components.css"]
  },
  "ui-overrides": "./components"
}
