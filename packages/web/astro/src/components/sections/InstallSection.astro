---
/**
 * InstallSection — "Get started" with the real 4-step flow:
 *   1. install the CLI globally (pnpm/npm/yarn CommandTabs)
 *   2. `sirenodeck start` -> first-run onboarding generates the config
 *   3. edit ~/.config/sireno-deck/config.yml (+ link to full docs)
 *   4. add 3rd-party addons & themes from npm (+ link to /addons/)
 *
 * Packaged builds (Flathub / DMG / MSI) are coming soon — shown as a muted
 * line with no commands to avoid confusion.
 */
import CommandTabs from "../CommandTabs.astro";
---

<section
  id="install"
  class="px-6 py-24 text-center"
  style="background: linear-gradient(180deg, var(--color-bg) 0%, var(--color-surface) 100%); border-top: 1px solid var(--color-border);"
>
  <div class="max-w-3xl mx-auto">
    <p class="font-mono text-xs font-semibold uppercase tracking-[0.25em] mb-4" style="color: var(--color-accent);">
      Get started
    </p>
    <h2 class="font-display text-4xl sm:text-5xl font-bold mb-4 text-fg">
      Up in 60 seconds
    </h2>
    <p class="text-lg mb-12" style="color: var(--color-muted);">
      Requires Node 20+. Pick your package manager once — we remember it everywhere.
    </p>

    <div class="flex flex-col gap-8 text-left" data-reveal-group>
      {/* 1. Install */}
      <div class="rounded-xl overflow-hidden" style="background: var(--color-bg); border: 1px solid var(--color-border);" data-reveal>
        <div class="flex items-center gap-4 px-6 py-4">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background: var(--color-accent); color: var(--color-bg);">1</div>
          <p class="text-sm font-semibold text-fg">Install the CLI</p>
        </div>
        <div class="px-6 pb-5">
          <CommandTabs
            pnpm="pnpm i -g @sirenodeck/cli"
            npm="npm i -g @sirenodeck/cli"
            yarn="yarn global add @sirenodeck/cli"
            label="Install the CLI"
          />
        </div>
      </div>

      {/* 2. Onboard */}
      <div class="rounded-xl overflow-hidden" style="background: var(--color-bg); border: 1px solid var(--color-border);" data-reveal>
        <div class="flex items-center gap-4 px-6 py-4">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background: var(--color-accent); color: var(--color-bg);">2</div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-fg">Start the onboarding</p>
            <div class="mt-2 rounded-md px-4 py-2.5 font-mono text-sm overflow-x-auto" style="background: var(--color-surface); color: var(--color-accent);">
              sirenodeck start
            </div>
          </div>
        </div>
        <div class="px-6 pb-4 text-xs" style="color: var(--color-muted);">
          First run launches onboarding: pick your device (or the emulator), connect, done. A starter <code class="font-mono">config.yml</code> is generated for you.
        </div>
      </div>

      {/* 3. Configure */}
      <div class="rounded-xl overflow-hidden" style="background: var(--color-bg); border: 1px solid var(--color-border);" data-reveal>
        <div class="flex items-center gap-4 px-6 py-4">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background: var(--color-accent); color: var(--color-bg);">3</div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-fg">Make it yours</p>
            <div class="mt-2 rounded-md px-4 py-2.5 font-mono text-sm overflow-x-auto" style="background: var(--color-surface); color: var(--color-accent);">
              ~/.config/sireno-deck/config.yml
            </div>
          </div>
        </div>
        <div class="px-6 pb-4 text-xs" style="color: var(--color-muted);">
          Edit the generated config — decks, buttons, themes. Changes apply on save.
          <a href="/user/configuration-files/" class="underline ml-1" style="color: var(--color-accent);">Full configuration reference</a>
        </div>
      </div>

      {/* 4. 3rd-party addons & themes */}
      <div class="rounded-xl overflow-hidden" style="background: var(--color-bg); border: 1px solid var(--color-border);" data-reveal>
        <div class="flex items-center gap-4 px-6 py-4">
          <div class="w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0" style="background: var(--color-accent); color: var(--color-bg);">4</div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-fg">Extend it</p>
            <div class="mt-2">
              <CommandTabs
                pnpm="pnpm i -g @sirenodeck/addon-app-shortcuts"
                npm="npm i -g @sirenodeck/addon-app-shortcuts"
                yarn="yarn global add @sirenodeck/addon-app-shortcuts"
                label="Install a 3rd-party addon"
              />
            </div>
          </div>
        </div>
        <div class="px-6 pb-4 text-xs" style="color: var(--color-muted);">
          Then reference it in your config:
          <code class="font-mono ml-1" style="color: var(--color-accent);">addons: ["@sirenodeck/addon-app-shortcuts"]</code>.
          <a href="/addons/" class="underline ml-1" style="color: var(--color-accent);">Browse the addon registry</a>
        </div>
      </div>
    </div>

    {/* Packaged builds — coming soon, no commands */}
    <p class="text-xs mt-10" style="color: var(--color-muted);">
      Packaged builds —
      <span class="font-semibold" style="color: var(--color-fg);">Flathub</span> ·
      <span class="font-semibold" style="color: var(--color-fg);">DMG</span> ·
      <span class="font-semibold" style="color: var(--color-fg);">MSI</span>
      — coming soon.
    </p>

    <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
      <a
        href="https://github.com/sergiocarracedo/sireno-deck"
        target="_blank"
        rel="noopener noreferrer"
        class="px-6 py-3 rounded-lg text-sm font-semibold"
        style="background: var(--color-accent); color: var(--color-bg);"
      >
        GitHub
      </a>
      <a
        href="/user/installation/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg text-sm font-semibold"
        style="background: transparent; color: var(--color-fg); border: 1px solid var(--color-border);"
      >
        Documentation
        <i data-lucide="book-open" class="w-4 h-4"></i>
      </a>
    </div>
  </div>
</section>
