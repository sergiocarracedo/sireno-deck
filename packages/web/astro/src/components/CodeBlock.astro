---
/**
 * CodeBlock — terminal-style code preview with traffic-light dots.
 *
 * ponytail: pure <pre>, no Shiki. The page is dark and small — a single
 * hand-styled block reads better than running a syntax highlighter.
 */
interface Props {
  filename?: string
  language?: string
  code: string
}

const { filename = "config.yml", language = "yaml", code } = Astro.props
---

<div class="rounded-xl overflow-hidden" style="background: var(--color-surface); border: 1px solid var(--color-border);">
  <div
    class="flex items-center gap-2 px-4 py-2.5"
    style="background: var(--color-surface-raised); border-bottom: 1px solid var(--color-border);"
  >
    <span class="w-3 h-3 rounded-full" style="background: #ef4444;"></span>
    <span class="w-3 h-3 rounded-full" style="background: #eab308;"></span>
    <span class="w-3 h-3 rounded-full" style="background: #22c55e;"></span>
    <span class="ml-2 text-xs font-mono" style="color: var(--color-muted);">{filename}</span>
  </div>
  <pre class="p-5 overflow-x-auto text-xs leading-relaxed font-mono" data-language={language}><code><slot>{code}</slot></code></pre>
</div>