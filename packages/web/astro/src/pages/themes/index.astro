---
/**
 * /themes/ — registry page. Two sections: Built-in + Third-party.
 */
import Layout from "../../layouts/Base.astro"
import ThemeCard from "../../components/ThemeCard.astro"
import ShaderBackdrop from "../../components/ShaderBackdrop.astro"
import { getCollection } from "astro:content"

const themes = await getCollection("themes")
const builtIns = themes.filter((t) => t.data.category === "builtin").sort((a, b) => a.data.order - b.data.order)
const thirdParty = themes.filter((t) => t.data.category === "third-party").sort((a, b) => a.data.order - b.data.order)
---

<Layout title="Theme Registry — Sireno Deck" description="Browse and discover themes for Sireno Deck.">
  <section class="relative px-6 pt-32 pb-12 text-center overflow-hidden">
    <ShaderBackdrop variant="page" />
    <div class="relative">
      <h1 class="font-display text-4xl sm:text-6xl font-bold mb-4">
        Theme <span style="color: var(--color-accent-2);">Registry</span>
      </h1>
      <p class="text-lg max-w-xl mx-auto" style="color: var(--color-muted);">
        Customize your Sireno Deck with beautiful themes or create your own.
      </p>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pb-24">
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 mb-10">
      <div class="relative flex-1 max-w-md">
        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2" style="color: var(--color-muted);"></i>
        <input
          id="theme-search"
          type="text"
          placeholder="Search themes..."
          class="w-full pl-10 pr-4 py-2.5 rounded-md text-sm"
          style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-fg);"
        />
      </div>
      <div class="flex flex-wrap gap-2">
        {[
          { id: "all", label: "All", icon: "grid-3x3" },
          { id: "builtin", label: "Built-in", icon: "package-check" },
          { id: "third-party", label: "Third-party", icon: "users" },
        ].map((f, i) => (
          <button
            type="button"
            data-filter={f.id}
            class={`filter-btn flex items-center gap-1.5 px-3 py-2 rounded-md text-xs font-medium transition-colors ${i === 0 ? "active" : ""}`}
            style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);"
          >
            <i data-lucide={f.icon} class="w-3.5 h-3.5"></i>
            {f.label}
          </button>
        ))}
      </div>
    </div>

    <section class="mb-16">
      <h2 class="font-display text-2xl font-semibold mb-6">Built-in Themes</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {builtIns.map((t) => (
          <div data-theme-card data-category={t.data.category} data-name={t.data.displayName.toLowerCase()}>
            <ThemeCard id={t.id} {...t.data} />
          </div>
        ))}

        {/* Create-your-theme CTA card */}
        <a
          href="/developer/theme-authoring/"
          class="flex flex-col items-center justify-center text-center rounded-xl p-8 min-h-[300px] transition-all hover:-translate-y-1"
          style="background: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-raised) 100%); border: 1px solid var(--color-accent-2);"
        >
          <div
            class="w-16 h-16 rounded-2xl flex items-center justify-center mb-5"
            style="background: rgba(167, 139, 250, 0.1);"
          >
            <i data-lucide="palette" class="w-8 h-8" style="color: var(--color-accent-2);"></i>
          </div>
          <h3 class="font-display text-xl mb-3 text-fg">Create Your Theme</h3>
          <p class="mb-5 max-w-xs text-sm" style="color: var(--color-muted);">
            Build a custom theme with your own colors, typography, and styling preferences.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-2 rounded" style="background: var(--color-accent-2); color: var(--color-bg);">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            Start Creating
          </span>
        </a>
      </div>
    </section>

    <section>
      <h2 class="font-display text-2xl font-semibold mb-6">Third-party Themes</h2>
      {thirdParty.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {thirdParty.map((t) => (
            <div data-theme-card data-category={t.data.category} data-name={t.data.displayName.toLowerCase()}>
              <ThemeCard id={t.id} {...t.data} />
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-16 rounded-xl" style="background: var(--color-surface); border: 1px dashed var(--color-border);">
          <i data-lucide="palette" class="w-12 h-12 mx-auto mb-4 opacity-50" style="color: var(--color-muted);"></i>
          <h3 class="font-display text-xl mb-2 text-fg">No community themes yet</h3>
          <p class="text-sm mb-6" style="color: var(--color-muted);">Share your custom theme with the community!</p>
          <a
href="/developer/theme-authoring/"
            class="inline-block px-5 py-2.5 rounded-lg text-sm font-semibold"
            style="background: var(--color-accent-2); color: var(--color-bg);"
          >
            Learn how to build themes
          </a>
        </div>
      )}
    </section>
  </div>

  <script is:inline>
    (() => {
      const search = document.getElementById("theme-search")
      const filterBtns = document.querySelectorAll(".filter-btn")
      const cards = document.querySelectorAll("[data-theme-card]")
      let currentFilter = "all"
      let query = ""

      const apply = () => {
        cards.forEach((card) => {
          const name = (card.getAttribute("data-name") || "").toLowerCase()
          const category = card.getAttribute("data-category") || ""
          const matchesSearch = !query || name.includes(query)
          const matchesFilter = currentFilter === "all" || category === currentFilter
          ;(card).style.display = matchesSearch && matchesFilter ? "" : "none"
        })
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach((b) => {
            b.classList.remove("active")
            b.style.background = "var(--color-surface)"
            b.style.color = "var(--color-muted)"
            b.style.borderColor = "var(--color-border)"
          })
          btn.classList.add("active")
          btn.style.background = "var(--color-surface-raised)"
          btn.style.color = "var(--color-fg)"
          btn.style.borderColor = "var(--color-accent)"
          currentFilter = btn.getAttribute("data-filter") || "all"
          apply()
        })
      })

      if (search) {
        search.addEventListener("input", (e) => {
          query = (e.target.value || "").toLowerCase()
          apply()
        })
      }

      const allBtn = document.querySelector('.filter-btn[data-filter="all"]')
      if (allBtn) {
        allBtn.style.background = "var(--color-surface-raised)"
        allBtn.style.color = "var(--color-fg)"
        allBtn.style.borderColor = "var(--color-accent)"
      }
    })()
  </script>
</Layout>