  "value-display:display": {
    "jsonSchema": {
      "type": "object",
      "properties": {
        "values": {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "title": "Value label"
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "title": "Shell command",
                "x-control": "shell"
              },
              "formatter": {
                "default": "raw",
                "title": "Output format",
                "type": "string",
                "enum": ["raw", "strip", "line"]
              },
              "units": {
                "title": "Units",
                "type": "string"
              },
              "timeout_ms": {
                "title": "Timeout (ms)",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "icon": {
                "title": "Icon",
                "x-control": "icon",
                "type": "string"
              }
            },
            "required": ["label", "command"],
            "additionalProperties": false
          },
          "title": "Values"
        },
        "poll_interval_ms": {
          "default": 5000,
          "title": "Refresh interval (ms)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "timeout_ms": {
          "default": 5000,
          "title": "Command timeout (ms)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": ["values"],
      "additionalProperties": false
    },
    "example": {}
  },
  "weather:weather": {
    "jsonSchema": {
      "type": "object",
      "properties": {
        "location": {
          "title": "Location",
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "title": "Latitude"
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "title": "Longitude"
            },
            "name": {
              "title": "Location name",
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["latitude", "longitude"],
          "additionalProperties": false
        },
        "poll_interval_ms": {
          "default": 600000,
          "title": "Refresh interval (ms)",
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "units": {
          "default": "metric",
          "title": "Units",
          "type": "string",
          "enum": ["metric", "imperial"]
        }
      },
      "additionalProperties": false
    },
    "example": {
      "poll_interval_ms": 600000,
      "units": "metric"
    }
  },
