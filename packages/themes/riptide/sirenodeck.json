  "effects": {
    "glow": {
      "sm": "0 0 6px var(--sireno-color-primary)",
      "md": "0 0 12px var(--sireno-color-primary), 0 0 22px var(--sireno-color-accent)",
      "lg": "0 0 18px var(--sireno-color-primary), 0 0 38px var(--sireno-color-accent)"
