---
/**
 * Pillars — 3-column grid of Sireno Deck's core value propositions.
 */
const pillars = [
  {
    label: "Declarative",
    icon: "◎",
    heading: "Your whole deck is a YAML file.",
    body: "A single config.yml drives every button, every page, every gesture. No GUIs, no modal dialogs. The deck lives next to your shell config.",
  },
  {
    label: "Overlay Decks",
    icon: "⬡",
    heading: "The deck reshapes itself.",
    body: "Overlay decks activate when a window gains focus. One button layout for OBS, another for your terminal, another for the meeting app. The deck follows your attention.",
  },
  {
    label: "Themable",
    icon: "◐",
    heading: "Pixel-perfect, every time.",
    body: "CSS tokens, font overrides, or full React component substitution. Your deck can look like anything — a retro arcade, a minimal monochrome, a living data dashboard.",
  },
]
---

<section class="py-28 px-6" style="background: #252b36;">
  <div class="max-w-6xl mx-auto">
    <p
      class="text-xs font-semibold tracking-[0.2em] uppercase text-center mb-4"
      style="color: #7dd3fc;"
    >
      Why Sireno Deck
    </p>
    <h2 class="text-4xl font-semibold text-center mb-20" style="color: #eef2f7;">
      Three ideas. One deck.
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        pillars.map((p) => (
          <div class="rounded-2xl p-8" style="background: #2e3540; border: 1px solid #3a4050;">
            <div
              class="text-3xl mb-5"
              style="color: #7dd3fc;"
              aria-hidden="true"
            >
              {p.icon}
            </div>
            <p
              class="text-xs font-semibold tracking-[0.15em] uppercase mb-3"
              style="color: #c3f5ff;"
            >
              {p.label}
            </p>
            <h3 class="text-xl font-semibold mb-4" style="color: #eef2f7;">
              {p.heading}
            </h3>
            <p class="text-base leading-relaxed" style="color: #8a9bb5;">
              {p.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
