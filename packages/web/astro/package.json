{
  "name": "sirenodeck-web",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "Sireno Deck marketing site + documentation (Astro 5 + Starlight).",
  "scripts": {
    "sync-tokens": "node ../scripts/sync-tokens.mjs",
    "predev": "pnpm run sync-tokens",
    "dev": "astro dev",
    "prebuild": "pnpm run sync-tokens",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "oxlint src astro.config.mjs",
    "format": "oxfmt src astro.config.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/starlight": "^0.41.5",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^7.1.6",
    "sharp": "^0.34.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/oxide": "^4.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "^5.6.0"
  }
}
