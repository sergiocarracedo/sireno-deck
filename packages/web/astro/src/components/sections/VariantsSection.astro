---
/**
 * VariantsSection — carousel of media deck rendered in every buttonColor.
 *
 * One deck per variant: blue / green / purple / cyan / magenta / amber / lime
 * plus the default. Each is a web-snapshot deck with buttonColor applied.
 */
import DeckCarousel from "../carousel/DeckCarousel.astro"

const slides = [
  {
    id: "variant-default",
    imageSrc: "/captures/web-snapshot-media.png",
    eyebrow: "Default",
    title: "The base palette.",
    body: "No tint — the fallback of every button. Start here, then pick a color.",
  },
  {
    id: "variant-blue",
    imageSrc: "/captures/web-snapshot-color-blue.png",
    eyebrow: "Blue",
    title: "Calm and trustworthy.",
    body: "The accent blue from the default theme, lifted into the deck frame.",
  },
  {
    id: "variant-green",
    imageSrc: "/captures/web-snapshot-color-green.png",
    eyebrow: "Green",
    title: "Fresh and balanced.",
    body: "Success green — ideal for confirmation tiles and live status.",
  },
  {
    id: "variant-purple",
    imageSrc: "/captures/web-snapshot-color-purple.png",
    eyebrow: "Purple",
    title: "Creative and bold.",
    body: "The secondary accent, saturated enough to read as a brand color.",
  },
  {
    id: "variant-cyan",
    imageSrc: "/captures/web-snapshot-color-cyan.png",
    eyebrow: "Cyan",
    title: "Electric and modern.",
    body: "Cyan pops on dark backgrounds — perfect for media and highlights.",
  },
  {
    id: "variant-magenta",
    imageSrc: "/captures/web-snapshot-color-magenta.png",
    eyebrow: "Magenta",
    title: "Vivid and energetic.",
    body: "Magenta frames turn any button into a call-to-action.",
  },
  {
    id: "variant-amber",
    imageSrc: "/captures/web-snapshot-color-amber.png",
    eyebrow: "Amber",
    title: "Warm and alert.",
    body: "Amber for warnings, timers, and anything you shouldn't miss.",
  },
  {
    id: "variant-lime",
    imageSrc: "/captures/web-snapshot-color-lime.png",
    eyebrow: "Lime",
    title: "Zesty and playful.",
    body: "Lime for the last slot — unexpected, memorable, unmistakably yours.",
  },
]
---

<section class="relative py-28 px-6 bg-bg">
  <div class="mx-auto max-w-5xl">
    <header class="mx-auto max-w-2xl text-center mb-12">
      <p class="text-xs font-semibold tracking-[0.25em] uppercase mb-3" style="color: var(--color-accent);">
        Variants
      </p>
      <h2 class="text-4xl sm:text-5xl font-semibold tracking-tight leading-[1.05] text-fg">One deck, every color.</h2>
      <p class="mt-5 text-base leading-relaxed" style="color: var(--color-muted);">
        The same four buttons, seven palettes. Pick the tint that fits your desk, your mood, your brand.
      </p>
    </header>
    <DeckCarousel slides={slides} />
  </div>
</section>