---
/**
 * /addons/[slug]/ — addon detail page.
 *
 * The documentation index links to the full sections below. Content stays
 * visible so the page works without JavaScript and can be scanned or printed.
 */
import Layout from "../../layouts/Base.astro"
import ShaderBackdrop from "../../components/ShaderBackdrop.astro"
import Icon from "../../components/Icon.astro"
import { getCollection, getEntry } from "astro:content"
import { buttonTypeBlocks } from "../../lib/addon-config-examples"
import AddonConfigExample from "../../components/AddonConfigExample.astro"
import AddonSchemaTable from "../../components/AddonSchemaTable.astro"
import MiniCarousel from "../../components/MiniCarousel.astro"
import CommandTabs from "../../components/CommandTabs.astro"

export async function getStaticPaths() {
  const addons = await getCollection("addons")
  return addons.map((a) => ({ params: { slug: a.id }, props: { id: a.id } }))
}

const { id } = Astro.props
const entry = await getEntry("addons", id)
if (!entry) throw new Error(`addon ${id} not found`)
const a = entry.data
const kind = a.source === "cli" ? "built-in" : a.category === "official" ? "official" : "community"
const isBuiltIn = a.source === "cli"
const isCommunity = kind === "community"

const typeBlocks = buttonTypeBlocks(a.buttonTypes ?? [])
const blockOf = (typeId: string) => typeBlocks.find((t) => t.typeId === typeId && t.body !== null)
const hasTypes = a.buttonTypes.length > 0
// ponytail: open the example <details> when a page only has a couple of
// types. Computed here so the template never contains a bare `<` inside an
// expression — the astro parser reads that as the start of a tag.
const expandDetails = typeBlocks.filter((t) => t.body !== null).length === 1 || typeBlocks.filter((t) => t.body !== null).length === 2
---

<Layout
  title={`${a.displayName} — Sireno Deck Addon`}
  description={a.description}
  ogImage={a.screenshot ?? a.screenshots[0]}
>
  <section class="relative px-6 pt-32 pb-16 overflow-hidden">
    <ShaderBackdrop variant="page" />
    <div class="relative max-w-5xl mx-auto">
      <a href="/addons/" class="inline-flex items-center gap-1 text-xs mb-6" style="color: var(--color-muted);">
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        Back to registry
      </a>

      <div class="flex items-start gap-5 mb-6">
        <div class="w-16 h-16 rounded-xl flex items-center justify-center flex-shrink-0" style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <i data-lucide={a.icon} class="w-8 h-8" style="color: var(--color-accent);"></i>
        </div>
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="font-display text-4xl font-bold text-fg">{a.displayName}</h1>
            <span
              class="text-xs font-mono px-2 py-0.5 rounded"
               style={!isCommunity
                ? "background: rgba(34, 211, 238, 0.1); color: var(--color-accent);"
                : "background: rgba(167, 139, 250, 0.1); color: var(--color-accent-2);"}
            >
               {kind}
            </span>
          </div>
          <p class="text-lg max-w-2xl" style="color: var(--color-muted);">{a.description}</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 mb-10">
        {a.tags.map((t: string) => (
          <span class="text-xs font-mono px-2 py-1 rounded" style="background: var(--color-surface-raised); color: var(--color-muted);">{t}</span>
        ))}
      </div>

      {(() => {
        const shots: string[] = [
          ...((a as unknown as { screenshots?: string[] }).screenshots ?? []),
          ...(a.screenshot ? [a.screenshot] : []),
        ].filter((v, i, arr) => arr.indexOf(v) === i);
        if (shots.length === 0) return null;
        if (shots.length === 1) {
          return (
            <div class="rounded-xl overflow-hidden mb-12" style="border: 1px solid var(--color-border);">
              <img src={shots[0]} alt={`${a.displayName} preview`} class="w-full block" />
            </div>
          );
        }
        return (
          <div class="mb-12 aspect-[16/9]">
            <MiniCarousel images={shots} alt={`${a.displayName} preview`} />
          </div>
        );
      })()}

      <nav class="flex flex-wrap gap-2 mb-10" aria-label={`${a.displayName} documentation`}>
          {[
            ["panel-overview", "Overview"],
            ["panel-buttons", "Button types"],
            ["panel-decks", "Decks"],
            ["panel-install", "Install"],
          ].map(([id, label]) => (
            <a
              href={`#${id}`}
              class="rounded-md px-4 py-2 text-sm font-medium transition-colors hover:text-fg"
              style="background: var(--color-surface); border: 1px solid var(--color-border); color: var(--color-muted);"
            >
              {label}
            </a>
          ))}
      </nav>

        <section id="panel-overview" class="scroll-mt-28 mb-10" aria-labelledby="heading-overview">
          <div class="grid lg:grid-cols-3 gap-6">
            <div class="rounded-xl p-6 lg:col-span-2" style="background: var(--color-surface); border: 1px solid var(--color-border);">
              <h2 id="heading-overview" class="font-display text-lg font-semibold mb-4">About this addon</h2>
              <p class="text-sm leading-relaxed" style="color: var(--color-muted);">{a.description}</p>
              {a.decks.length > 0 && <p class="mt-4 text-sm" style="color: var(--color-muted);">Publishes {a.decks.length} deck type{a.decks.length === 1 ? "" : "s"}.</p>}
            </div>
            <div class="rounded-xl p-6 flex flex-col gap-6" style="background: var(--color-surface); border: 1px solid var(--color-border);">
          <h2 class="font-display text-lg font-semibold mb-0">Links</h2>
           {isBuiltIn ? (
            <div class="flex flex-col gap-3">
              <p class="text-sm leading-relaxed" style="color: var(--color-muted);">
                First-party addon from this repository. Enable its buttons
                straight from your
                <code class="font-mono text-xs px-1 py-0.5 rounded" style="background: var(--color-bg);">config.yml</code>
                — nothing to install separately.
              </p>
              {a.repo && (
                <a
                  href={a.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm transition-colors hover:text-fg"
                  style="color: var(--color-muted);"
                >
                  <i data-lucide="github" class="w-4 h-4"></i>
                  Source on GitHub
                </a>
              )}
            </div>
          ) : (
            <ul class="space-y-3 text-sm">
              {a.npm && (
                <li>
                  <a
                    href={`https://www.npmjs.com/package/${a.npm}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 transition-colors hover:text-fg"
                    style="color: var(--color-muted);"
                  >
                    <i data-lucide="package" class="w-4 h-4"></i>
                    <code class="font-mono">{a.npm}</code>
                  </a>
                </li>
              )}
              {a.repo && (
                <li>
                  <a
                    href={a.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 transition-colors hover:text-fg"
                    style="color: var(--color-muted);"
                  >
                    <i data-lucide="github" class="w-4 h-4"></i>
                    Source on GitHub
                  </a>
                </li>
              )}
            </ul>
          )}
           {isCommunity && !a.npm && !a.repo && (
            <p class="text-sm" style="color: var(--color-muted);">Community package.</p>
          )}
            </div>
          </div>
        </section>

        <section id="panel-buttons" class="scroll-mt-28 mb-10" aria-labelledby="heading-buttons">
          <div class="rounded-xl p-6" style="background: var(--color-surface); border: 1px solid var(--color-border);">
            <h2 id="heading-buttons" class="font-display text-lg font-semibold mb-4">Button types and configuration</h2>
            {hasTypes ? (
              <ul class="space-y-8">
                {a.buttonTypes.map((bt: string) => (
                  <li>
                    <code class="text-sm font-mono px-3 py-1.5 rounded inline-block" style="background: var(--color-bg); color: var(--color-accent); border: 1px solid var(--color-border);">{bt}</code>
                    <AddonSchemaTable typeId={bt} />
                    {bt === "system-status:system-status" && (
                      <div class="mt-6">
                        <p class="text-sm" style="color: var(--color-muted);">
                          Configure up to five pages. Each page chooses its own
                          layout and metric count:
                        </p>
                        <div class="mt-3 grid gap-3 sm:grid-cols-3">
                          {[
                            ["bars", "Bars", "1–3 metrics with progress bars."],
                            ["kpis", "KPIs", "1–3 metrics as large values."],
                            ["chart", "Chart", "1–2 metrics over up to 60 seconds."],
                          ].map(([type, label, description]) => (
                            <div class="rounded-lg p-4" style="background: var(--color-bg); border: 1px solid var(--color-border);">
                              <code class="font-mono text-sm" style="color: var(--color-accent);">{type}</code>
                              <h3 class="mt-2 text-sm font-semibold">{label}</h3>
                              <p class="mt-1 text-xs" style="color: var(--color-muted);">{description}</p>
                            </div>
                          ))}
                        </div>
                        <pre class="mt-4 rounded-lg p-4 text-xs font-mono overflow-x-auto" style="background: var(--color-bg); border: 1px solid var(--color-border);"><code>pages:
  - type: bars
    metrics: [cpu, ram, disk]
  - type: kpis
    metrics: [temperature, uptime]
  - type: chart
    metrics: [cpu]
    windowSeconds: 60</code></pre>
                      </div>
                    )}
                    {(() => {
                      const b = blockOf(bt)
                      return b ? <AddonConfigExample typeId={bt} body={b.body ?? ""} open={expandDetails} /> : null
                    })()}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm" style="color: var(--color-muted);">This addon publishes decks without user-facing button types.</p>
            )}
          </div>
        </section>

        <section id="panel-decks" class="scroll-mt-28 mb-10" aria-labelledby="heading-decks">
          <div class="rounded-xl p-6" style="background: var(--color-surface); border: 1px solid var(--color-border);">
            <h2 id="heading-decks" class="font-display text-lg font-semibold mb-4">Decks</h2>
            {a.decks.length > 0 ? (
              <ul class="space-y-3">
                {a.decks.map((deck: string) => (
                  <li class="rounded-lg p-4" style="background: var(--color-bg); border: 1px solid var(--color-border);">
                    <code class="font-mono text-sm" style="color: var(--color-accent);">{deck}</code>
                    <p class="mt-2 text-xs" style="color: var(--color-muted);">Use this deck id in a <code>core:change-deck</code> button or configure its generated deck through the addon settings.</p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm" style="color: var(--color-muted);">This addon does not publish additional decks.</p>
            )}
          </div>
        </section>

        <section id="panel-install" class="scroll-mt-28 mb-10" aria-labelledby="heading-install">
          <div class="rounded-xl overflow-hidden" style="background: var(--color-surface); border: 1px solid var(--color-accent);">
            <h2 id="heading-install" class="text-xs font-semibold uppercase tracking-widest px-6 pt-5 pb-3" style="color: var(--color-accent-2);">Install and configure</h2>
             {isBuiltIn ? (
              <p class="px-6 pb-5 text-sm" style="color: var(--color-muted);">
                This official addon is included with Sireno Deck. Add its button
                types or decks directly to your <code class="font-mono">config.yml</code>.
              </p>
            ) : a.npm ? (
              <>
                <div class="px-6 pb-2">
                  <CommandTabs
                    pnpm={`pnpm add ${a.npm}`}
                    npm={`npm i ${a.npm}`}
                    yarn={`yarn add ${a.npm}`}
                    label={`Install ${a.displayName}`}
                  />
                </div>
                <pre class="px-6 pb-2 text-sm font-mono overflow-x-auto" style="color: var(--color-fg);"><code># reference it in config.yml
addons:
  - "{a.npm}"</code></pre>
                <p class="px-6 pb-5 text-xs" style="color: var(--color-muted);">
                  Full path or npm name both work in the addons list. See
                  <a href="/user/configuration-files/" class="underline">configuration docs</a>.
                </p>
              </>
            ) : (
              <p class="px-6 pb-5 text-sm" style="color: var(--color-muted);">Ask the addon author for installation instructions.</p>
            )}
          </div>
        </section>
    </div>
  </section>
</Layout>
