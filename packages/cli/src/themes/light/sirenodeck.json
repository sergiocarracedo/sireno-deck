{
  "kind": "theme",
  "apiVersion": 1,
  "name": "light",
  "version": "0.1.0",
  "description": "The light theme for Sireno Deck. Supports prefers-color-scheme: dark.",
  "colorTokens": {
    "background": "#eef2f7",
    "frame": "#53738B",
    "foreground": "#2e3540",
    "foreground-contrast": "#000000",
    "primary": "#7dd3fc",
    "accent": "#C3F5FF",
    "success": "#34d399",
    "danger": "#FFB4AB"
  },
  "typography": {
    "main_text": {
      "fontFamily": "IBM Plex Sans",
      "fontSize": 12,
      "fontWeight": 100
    },
    "auxiliary_text": {
      "fontFamily": "IBM Plex Sans",
      "fontSize": 8,
      "fontWeight": 300,
      "letterSpacing": 1.2
    },
    "monospace": {
      "fontFamily": "IBM Plex Mono",
      "fontSize": 10,
      "fontWeight": 300,
      "letterSpacing": 0.4
    }
  },
  "assets": {
    "styles": ["./tokens.css", "./dark.css", "./components.css"]
  },
  "entry": "./index"
}
